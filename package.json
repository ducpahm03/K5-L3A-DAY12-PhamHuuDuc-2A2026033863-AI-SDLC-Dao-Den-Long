{
  "name": "dao-den-long",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 4173",
    "build:web": "vite build",
    "build:headless": "esbuild src/headless/cli.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/headless.mjs",
    "build:bench": "esbuild src/headless/bench.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/bench.mjs",
    "build:soak": "esbuild src/headless/soak.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/soak.mjs",
    "build": "npm run build:web && npm run build:headless && npm run build:bench && npm run build:soak",
    "bench": "node dist/bench.mjs",
    "soak": "node dist/soak.mjs",
    "start": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync-check": "node scripts/sync-check.mjs",
    "verify": "node scripts/verify-all.mjs",
    "record-demo": "node scripts/record-demo.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "esbuild": "^0.24.2",
    "playwright": "^1.65.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
